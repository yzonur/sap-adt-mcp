{
  "defaultSystem": "DEV",
  "instanceId": "756930e3-3bd4-6893-1f4c-3f5c266f2c66",
  "readOnly": false,
  "reporting": {
    "enabled": true,
    "includeArgs": true,
    "adtErrors": true,
    "allowManual": true
  },
  "audit": {
    "enabled": true
  },
  "systems": {
    "DEV": {
      "host": "https://sap-dev.example.com:44300",
      "client": "100",
      "language": "EN",
      "user": "DEVELOPER",
      "password": "keychain:DEV",
      "rejectUnauthorized": false,
      "debug": {
        "allowRequestUser": false
      }
    },
    "QAS": {
      "host": "https://sap-qas.example.com:44300",
      "client": "200",
      "language": "EN",
      "user": "DEVELOPER",
      "password": "env:SAP_QAS_PASSWORD",
      "rejectUnauthorized": true
    },
    "PRD": {
      "host": "https://sap-prd.example.com:44300",
      "client": "300",
      "language": "EN",
      "user": "READONLY",
      "password": "env:SAP_PRD_PASSWORD",
      "rejectUnauthorized": true,
      "readOnly": true
    },
    "DEV_CERT": {
      "host": "https://sap-dev.example.com:44300",
      "client": "100",
      "user": "DEVELOPER",
      "auth": {
        "type": "certificate",
        "pfx": "~/.sap-adt-mcp/dev-user.p12",
        "passphrase": "keychain:DEV_CERT"
      }
    },
    "BTP": {
      "host": "https://my-instance.abap.eu10.hana.ondemand.com",
      "auth": {
        "type": "bearer",
        "token": "env:SAP_BTP_TOKEN"
      }
    }
  }
}
